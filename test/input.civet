describe "input", ->
  template := makeTemplate """
    input(type="text" @value)
  """

  it.skip "should maintain caret position", ->
    model :=
      value: Observable "yolo"

    input := template(model)

    input.focus()
    input.selectionStart = 2

    assert.equal input.selectionStart, 2

    input.value = "yo2lo"
    // input.selectionStart = 3

    assert.equal input.selectionStart, 3

    input.onchange?(new Event("change"))

    assert.equal input.selectionStart, 3

  it "should start with given vaule", ->
    T := Jadelet.exec """
      input(type="text" value="hello")
    """

    el := T()
    assert.equal el.value, "hello"

  it "should accept a non-function (plain value) binding without throwing on input", ->
    model :=
      value: 5

    input := template(model)

    // initial value reflects the plain number
    assert.equal input.value, "5"

    // editing must not attempt to call the non-function binding
    input.value = "7"
    input.oninput()

    assert.equal input.value, "7"
